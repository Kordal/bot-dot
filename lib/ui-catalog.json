    "kpi": { "group": "data", "since": 1, "means": "One number with its label, its unit, what it is out of, a note and its recent values.", "sourced": true,
      "props": {
        "label": { "type": "string", "max": 60, "required": true }, "value": { "type": "string", "max": 40, "required": true },
        "unit": { "type": "string", "max": 20 }, "of": { "type": "string", "max": 20 }, "sub": { "type": "string", "max": 120 },
