        "points": { "type": "list", "of": { "type": "number", "nullable": true }, "max": 60, "counts": "points" },
        "tile": { "type": "string", "max": 80 }, "bind": { "type": "string", "max": 200 },
        "source": { "type": "string", "max": 120 }
      } },
    "stat-row": { "group": "data", "since": 1, "means": "KPIs side by side.",
      "props": {},
      "children": { "max": 6, "only": ["kpi"] } },
    "progress": { "group": "data", "since": 1, "means": "A bar showing how far something is, 0 to 100.",
      "props": {
        "label": { "type": "string", "max": 60, "required": true }, "value": { "type": "number", "min": 0, "max": 100, "required": true },
