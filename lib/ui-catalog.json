    "text": { "group": "text", "since": 1, "means": "A paragraph of plain text; line breaks are kept.",
      "props": { "text": { "type": "string", "max": 2000, "multiline": true, "required": true }, "tone": { "type": "tone", "default": "neutral" } } },
    "list": { "group": "text", "since": 1, "means": "A bulleted or numbered list of short lines.",
