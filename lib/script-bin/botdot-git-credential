#!/usr/bin/env node
// botdot-git-credential: git's credential helper in a bot's AI run (ADR 090), set by botdot through GIT_CONFIG_*, so
// nothing is written in a repository's .git/config or the bot's home. For `get` over HTTPS it asks botdot, with the
// run's own key (BOTDOT_GIT), and prints the token of a GitHub App login shared with the bot for that host: it ends
// within the hour, and the app's key never leaves botdot. For any other host, or with no such login, it prints
// nothing and git goes on as it would without it. `store` and `erase` do nothing: botdot keeps no password of git's.
const op = process.argv[2];
const base = process.env.BOTDOT_URL;
const key = process.env.BOTDOT_GIT;
if (op !== 'get' || !base || !key) process.exit(0);

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', async () => {
  const asked = {};
  for (const line of input.split('\n')) {
    const at = line.indexOf('=');
    if (at > 0) asked[line.slice(0, at)] = line.slice(at + 1);
  }
  if (asked.protocol !== 'https' || !asked.host) return;
  let r;
  try {
    const res = await fetch(`${base}/api/vault/git/credential`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Bot-Dot': '1', 'X-Run-Token': key },
      body: JSON.stringify({ protocol: asked.protocol, host: asked.host }),
    });
    r = await res.json();
  } catch (e) {
    return void process.stderr.write(`botdot: couldn't reach botdot for git's login: ${e.cause?.code || e.message}\n`);
  }
  if (!r?.ok) return void process.stderr.write(`botdot: ${r?.error || "git's login failed."}\n`);
  if (r.password) process.stdout.write(`username=${r.username}\npassword=${r.password}\n`);
});
