#!/opt/camoufox/bin/python
"""Camoufox on the desktop with a persistent profile, and botdot's bridge into it.

camoufox-browser --serve <display> <bot>
    botdot runs this as the browser user for each bot's screen (#105): one bridge and one Camoufox per screen, on
    that screen's display and with that bot's own profile. It opens Camoufox when asked and types a saved password,
    two-step code, card detail or identity detail into the page for botdot, after checking the site and the
    focused field. {"op": "where"} returns the site the browser is on. The browser tools ({"op": "snapshot"}, "click",
    "fill", "select", "find", "press", "goto", "wait", #170) read the page as its accessibility tree and act on it by ref. Those requests come only over
    BRIDGE_SOCKET, in a folder only the browser user can open, so no program of the bots that does not use sudo
    can receive or answer them (#311). 127.0.0.1:OPEN_PORT (inside the container only) takes {"op": "open"} and
    {"op": "is-open"}, and nothing else.
camoufox-browser [url]
    Opens the url in the Camoufox of the screen it is run on (DISPLAY), starting it if it is closed: the dock's
    browser icon, xdg-open, open_browser.
camoufox-browser --is-open
    Exits 0 when the Camoufox of the screen it is run on is open, 1 when not (open_browser), then printing why its
    last start failed, when it did (a proxy that did not answer).

The bot's proxy (ADR 171): botdot sends {"op": "proxy", "proxy": {...} or null} over BRIDGE_SOCKET, and the bridge
keeps it in PROXY_FILE for its next start. With one, Camoufox goes through a SOCKS5 forwarder of the bridge's own on
127.0.0.1:PROXY_PORT, which reaches every site through the bot's proxy with its login, the site's name resolved there;
the bot's commands may use that forwarder too. A proxy that doesn't answer keeps the browser closed: nothing goes out
directly.

What the bridge and Camoufox print goes to BRIDGE_LOG, at most LOG_CAP bytes of the latest, and the previous
run's to BRIDGE_LOG.1 (#355).
"""
import atexit
import base64
import contextlib
import fcntl
import ipaddress
import json
import os
import queue
import random
import re
import socket
import socketserver
import ssl
import struct
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

# Camoufox (GTK) asks gvfs nothing: on a boat.dev machine gvfs mounted ~/.gvfs for the browser user, which not even
# root can read, and boat.dev could no longer save the machine (#812, #901). Camoufox inherits these.
os.environ["GIO_USE_VFS"] = "local"
os.environ["GVFS_DISABLE_FUSE"] = "1"

BRIDGE_SOCKET = "/run/botdot-browser/bridge.sock"
BRIDGE_LOG = "/home/browser/bridge.log"  # as told in lib/computers.js, above startBrowserBridge
LOG_CAP = 1024 * 1024
OPEN_PORT = 47111
PROFILE = os.path.expanduser("~/.camoufox-profile")
PROXY_FILE = "/home/browser/proxy.json"  # the bot's proxy, with its login: the browser user's alone
PROXY_PORT = 47300  # the forwarder into the bot's proxy, on the loopback: PROXY_PORT_BASE + the screen's number
PROXY_PORT_BASE = 47300
BOT = ""
# Where the browser saves downloads: box's on the account's computer, the bot's own home on a boat.dev machine (#563).
DOWNLOADS = os.environ.get("BOTDOT_DOWNLOADS") or "/home/box/Downloads"
# Screen :N's bridge port is OPEN_PORT_BASE + N, as lib/computers.js (screenPorts) has it.
OPEN_PORT_BASE = 47200
DISPLAY_FORM = re.compile(r"^:([0-9]{1,3})(\.[0-9]+)?$")
BOT_FORM = re.compile(r"^[a-z0-9][a-z0-9_-]{0,79}$")
NOT_OPEN = {"ok": False, "error": "Camoufox isn't open. Open the site with open_browser first."}
# How long botdot's helper waits for an answer, and the least time a request must have left to be started: one that
# waited in the queue longer is not done at all, so a step the bot was told failed never happens later on its own.
REPLY_SECONDS = 30
START_SECONDS = 20
BUSY = {"ok": False, "error": "The browser was still busy with an earlier step, so this was not done. Take a new browser_snapshot, then try again."}
requests = queue.Queue()  # (body, reply queue or None), served on the browser's thread
browser_open = threading.Event()  # Camoufox is open on this screen
browser_starting = threading.Event()  # Camoufox is being started on this screen: another open adds no tab


def for_screen(display, bot):
    """Point this bridge at screen `display` (":21") and the profile of `bot`: its own socket, log and port."""
    global BRIDGE_SOCKET, BRIDGE_LOG, OPEN_PORT, PROFILE, PROXY_FILE, PROXY_PORT, BOT
    m = DISPLAY_FORM.match(display or "")
    if not m or not BOT_FORM.match(bot or ""):
        raise SystemExit("camoufox-browser --serve takes a display and a bot")
    n = int(m.group(1))
    BOT = bot
    PROXY_FILE = f"/home/browser/proxy-{n}.json"
    PROXY_PORT = PROXY_PORT_BASE + n
    BRIDGE_SOCKET = f"/run/botdot-browser/bridge-{n}.sock"
    BRIDGE_LOG = f"/home/browser/bridge-{n}.log"
    OPEN_PORT = OPEN_PORT_BASE + n
    PROFILE = f"/home/browser/profiles/{bot}"


def port_of_display(display):
    """The bridge port of the screen a program runs on."""
    m = DISPLAY_FORM.match(display or "")
    return OPEN_PORT_BASE + int(m.group(1)) if m else OPEN_PORT


class BridgeHandler(socketserver.StreamRequestHandler):
    """botdot's helper (botdot-type-secret): one JSON request, read to its end, and one JSON answer."""

    def handle(self):
        try:
            body = json.loads(self.rfile.read(1024 * 1024))
        except ValueError:
            body = None
        if not isinstance(body, dict) or not body:  # e.g. bridge_running(), which sends nothing: not the browser's
            result = {"ok": False, "error": "The bridge takes one JSON request."}
        elif body.get("op") == "proxy":  # not the browser's thread: it may be starting, or held by a page
            result = take_proxy(body.get("proxy"))
            body.clear()
        else:
            reply = queue.Queue()
            body["_until"] = time.monotonic() + REPLY_SECONDS
            requests.put((body, reply))
            try:
                result = reply.get(timeout=REPLY_SECONDS)
            except queue.Empty:
                result = {"ok": False, "error": f"The browser did not respond within {REPLY_SECONDS} s. The step may still finish: take a new browser_snapshot before you try it again."}
        try:
            self.wfile.write(json.dumps(result).encode())
        except (BrokenPipeError, ConnectionResetError):  # the client has gone (#360): nothing to tell anyone
            pass


class OpenHandler(BaseHTTPRequestHandler):
    """Any program on the computer: it may open a page, and learns nothing else."""

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length))
        except ValueError:
            body = {}
        if isinstance(body, dict) and body.get("op") == "open":
            global start_error
            start_error = None  # this open's start says its own
            if not (browser_starting.is_set() and not browser_open.is_set()):  # one that starts opens its own page
                requests.put(({"op": "open", "url": str(body.get("url") or "about:blank")}, None))
            result = {"ok": True}
        elif isinstance(body, dict) and body.get("op") == "is-open":
            result = {"ok": True, "open": browser_open.is_set()}
            if not browser_open.is_set() and start_error:
                result["error"] = start_error
        else:
            result = {"ok": False, "error": "This only opens pages in Camoufox."}
        data = json.dumps(result).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


def host_matches(url, site):
    host = (urlparse(url).hostname or "").lower()
    site = site.lower()
    return host == site or host.endswith("." + site)


# Runs in the page: is the focused element the right kind of box?
FIELD_CHECK = """(field) => {
  const el = document.activeElement;
  if (!document.hasFocus() || !el || el.tagName !== 'INPUT') return 'none';
  const t = (el.getAttribute('type') || 'text').toLowerCase();
  if (field === 'password') return t === 'password' ? 'ok' : 'wrong';
  if (field === 'card') return ['text', 'tel', 'number', 'password', ''].includes(t) ? 'ok' : 'wrong';
  if (field === 'totp') return ['text', 'tel', 'number', 'password', ''].includes(t) ? 'ok' : 'wrong';
  return ['text', 'email', 'tel', 'search', ''].includes(t) ? 'ok' : 'wrong';
}"""


def focused_page(context):
    pages = [p for p in context.pages if not p.is_closed()]
    for p in pages:
        try:
            if p.evaluate("document.hasFocus()"):
                return p
        except Exception:
            pass
    return pages[-1] if pages else None


FIELD_KINDS = {"username", "password", "totp", "card", "text"}
FIELD_NAMES = {"username": "username", "password": "password", "totp": "two-step code", "card": "card", "text": "form"}


def type_secret(context, req):
    if req.get("op") == "open":  # a second launch (e.g. the dock's browser icon) opens a tab here
        page = context.new_page()
        if req.get("url", "about:blank") != "about:blank":
            page.goto(req["url"])
        page.bring_to_front()
        return {"ok": True}
    page = focused_page(context)
    if req.get("op") == "where":
        return {"ok": True, "host": (urlparse(page.url).hostname or "") if page else ""}
    field = req.get("field") if req.get("field") in FIELD_KINDS else "password"
    if page is None:
        return {"ok": False, "error": "Camoufox has no open page."}
    if field != "text" and not host_matches(page.url, req.get("site", "")):  # identity details: any site
        shown = urlparse(page.url).hostname or page.url
        return {"ok": False, "error": f"The browser is on {shown}, not {req.get('site')}. Open the right site first."}
    target = None
    for frame in page.frames:  # login forms are sometimes inside iframes
        try:
            if frame.evaluate(FIELD_CHECK, field) == "ok":
                target = frame
                break
        except Exception:
            pass
    if target is None:
        return {"ok": False, "error": f"Click the {FIELD_NAMES[field]} box first, then try again."}
    type_like_a_person(page, req.get("value", ""))
    if req.get("submit"):
        page.keyboard.press("Enter")
    return {"ok": True}


def type_like_a_person(page, text):
    """Each key with an uneven pause, as a person types: a steady 35 ms beat is a robot's (bot checks time keys)."""
    for ch in text:
        page.keyboard.type(ch)
        page.wait_for_timeout(random.randint(40, 250) if not ch.isspace() else random.randint(80, 300))


def fill_like_a_person(page, element, text):
    """A box's text replaced as a person does it: click into it, select what is there, and type key by key with
    uneven pauses. A site that sees text appear with no key pressed takes the visitor for a bot. A long text goes in at
    once, as pasted, and so does any box that can't be typed into this way (a date picker, an editor)."""
    # Only into a box that takes text: a click on a button, box or link the bot gave by mistake would be a step taken
    # past botdot's irreversible-step checks (ADR 107), which fill has none of; Enter or Tab in the text would be too.
    try:
        typeable = element.evaluate(TEXT_BOX) and element.is_editable(timeout=2000)
    except Exception:
        typeable = False
    if not typeable or len(text) > TYPED_FILL or "\n" in text or "\r" in text or "\t" in text:
        element.fill(text, timeout=10000)
        return
    try:
        element.click(timeout=5000)
        page.keyboard.press("Control+a")
        if not text:
            page.keyboard.press("Backspace")
        for ch in text:
            page.keyboard.type(ch)
            page.wait_for_timeout(random.randint(30, 140) if not ch.isspace() else random.randint(60, 200))
        if element.input_value(timeout=2000) == text:
            return
    except Exception:
        pass
    element.fill(text, timeout=10000)


# The browser tools (#170): a bot reads the focused page as its accessibility tree, each control with a ref, and clicks,
# fills, presses, goes and waits by ref, instead of by screenshot and screen position. The tree is Playwright's aria
# snapshot; a ref is the control's role, name and place among those of that role and name (of that role, for one
# without a name), so it is found again with get_by_role, and only in the page and at the address of the snapshot that gave it. Every tool answers with the new
# snapshot, whose refs replace the old ones. A secret box is never filled, and no secret box's value is shown.
BROWSER_OPS = {"snapshot", "click", "fill", "select", "find", "press", "goto", "wait"}
SNAPSHOT_CAP = 12000  # characters of the tree a bot gets at most
FULL_CAP = 60000  # characters of the tree browser_find looks through, sent whole to botdot (an External Virtual PC too)
FIND_LINES = 40
# Runs on an element: is it a box a person types text into?
TEXT_BOX = """(el) => el.tagName === 'TEXTAREA' || el.tagName === 'INPUT'
  && !['checkbox', 'radio', 'button', 'submit', 'reset', 'file', 'image', 'range', 'color', 'hidden'].includes((el.getAttribute('type') || '').toLowerCase())"""
TYPED_FILL = 80  # characters at most that browser_fill types key by key; a longer text goes in at once, as pasted
REF_ROLES = {"button", "link", "textbox", "searchbox", "checkbox", "radio", "combobox", "listbox", "option", "menuitem",
             "menuitemcheckbox", "menuitemradio", "tab", "switch", "slider", "spinbutton", "treeitem"}
SNAPSHOT_LINE = re.compile(r"^(\s*)- (.*)$")
SNAPSHOT_KEY = re.compile(r'([a-z]+)(?: ("(?:[^"\\]|\\.)*"))?')
HIDDEN = "••••"
refs = {}  # "e12" -> [page, url, role, name, nth, how many share its role and name]: the last snapshot's, on the browser's thread only
# Runs on an element: is it a box for a password, a card detail or a two-step code? Those take type_login, type_card.
SECRET_FIELD = """(el) => {
  if (!el || el.tagName !== 'INPUT') return false;
  if ((el.getAttribute('type') || '').toLowerCase() === 'password') return true;
  if (/(^|\\s)(cc-|one-time-code|current-password|new-password)/.test((el.getAttribute('autocomplete') || '').toLowerCase())) return true;
  const hint = [el.name, el.id, el.getAttribute('aria-label'), el.placeholder].join(' ').toLowerCase();
  return /passw|passcode|card.?num|cc.?num|cvc|cvv|csc|security.?code|one.?time|otp|2fa|two.?(step|factor)|verification.?code/.test(hint);
}"""
SECRET_VALUES = "() => Array.from(document.querySelectorAll('input')).filter(" + SECRET_FIELD + ").map((el) => el.value).filter(Boolean)"


class BrowserError(Exception):
    """A browser tool's answer to the bot, said as it is."""


def snapshot_key(rest):
    """The role and name at the start of a snapshot line's text, and where they end: `button "Log in"`, or the same
    in YAML's single quotes when the name holds a colon."""
    if rest.startswith("'"):
        i, key = 1, []
        while i < len(rest):
            if rest[i] == "'":
                if rest[i + 1:i + 2] != "'":
                    break
                i += 1
            key.append(rest[i])
            i += 1
        key, end = "".join(key), i + 1
    else:
        key, end = rest, None
    m = SNAPSHOT_KEY.match(key)
    if not m:
        return None, None, 0
    try:
        name = json.loads(m.group(2)) if m.group(2) else ""
    except ValueError:
        name = ""
    return m.group(1), name, end if end is not None else m.end()


def hide_secrets(value, secrets):
    """A box's shown value, or HIDDEN when it holds a secret box's value."""
    plain = value.strip()
    for quote in ('"', "'"):
        if len(plain) > 1 and plain[0] == quote == plain[-1]:
            plain = plain[1:-1]
    for s in secrets:
        if plain == s or len(s) >= 4 and (s in value or json.dumps(s)[1:-1] in value):
            return HIDDEN
    return value


def page_snapshot(page, cap=SNAPSHOT_CAP):
    """The page's tree with a ref on every control, cut at cap, and the refs it gave kept in `refs`."""
    refs.clear()
    try:
        secrets = [str(v) for v in page.evaluate(SECRET_VALUES) or []]
    except Exception:
        secrets = None
    try:
        tree = page.locator("body").aria_snapshot(timeout=10000)
    except Exception as exc:
        raise BrowserError(f"Couldn't read the page: {type(exc).__name__}. Take a screenshot instead.")
    counts, lines = {}, []
    for line in tree.splitlines():
        m = SNAPSHOT_LINE.match(line)
        if m:
            role, name, end = snapshot_key(m.group(2))
            at = len(m.group(1)) + 2 + end
            if role in REF_ROLES:
                # A nameless control is found among all of its role, as get_by_role without a name finds them.
                nth = counts.get((role, name), 0) if name else counts.get(role, 0)
                counts[(role, name)] = counts.get((role, name), 0) + 1
                counts[role] = counts.get(role, 0) + 1
                ref = f"e{len(refs) + 1}"
                refs[ref] = [page, page.url, role, name, nth, (role, name) if name else role]
                line = f"{line[:at]} [ref={ref}]{line[at:]}"
                at += len(ref) + 7
            rest = line[at:]
            colon = rest.find(": ")
            if colon >= 0 and rest[colon + 2:].strip():
                # A value we could not check is never shown: secrets is None when the page could not be asked.
                value = rest[colon + 2:]
                shown = HIDDEN if secrets is None and role in REF_ROLES else hide_secrets(value, secrets or [])
                line = line[:at] + rest[:colon + 2] + shown
        lines.append(line)
    for entry in refs.values():  # how many share its role and name: when that changes, its place no longer holds
        entry[5] = counts[entry[5]]
    text = "\n".join(lines)
    if len(text) > cap:
        cut = text.rfind("\n", 0, cap)
        text = text[:cut if cut > 0 else cap] + "\n(The page goes on: this is its start. Use browser_find for what you look for further down.)"
    try:
        title = page.title()
    except Exception:
        title = ""
    return f"Page: {title} ({page.url})\n{text or '(The page shows nothing the tree can read. Take a screenshot.)'}"


def locate(context, ref):
    """The element behind a ref of the last snapshot, or a BrowserError the bot can act on."""
    entry = refs.get(str(ref or ""))
    if entry is None:
        raise BrowserError(f"{ref or 'That'} is not a ref of your last browser_snapshot. Take a new snapshot.")
    page, url, role, name, nth, alike = entry
    stale = BrowserError(f"{ref} is stale: the page has changed since your last snapshot. Take a new snapshot.")
    if page.is_closed() or page is not focused_page(context) or page.url != url:
        raise stale
    found = page.get_by_role(role, name=name, exact=True) if name else page.get_by_role(role)
    if found.count() != alike:  # one of the same role and name came or went: the nth may be another now
        raise stale
    return page, found.nth(nth)


def settle(page):
    try:
        page.wait_for_load_state("domcontentloaded", timeout=5000)
    except Exception:
        pass
    page.wait_for_timeout(300)


def browser_tool(context, req):
    """One browser tool, run on the browser's thread: {"ok": True, "snapshot"} or {"ok": False, "error"}."""
    op = req.get("op")
    page = focused_page(context)
    if page is None:
        return {"ok": False, "error": "Camoufox has no open page."}
    note = ""
    try:
        if op == "click":
            page, element = locate(context, req.get("ref"))
            element.click(timeout=10000)
            settle(page)
        elif op == "fill":
            page, element = locate(context, req.get("ref"))
            if element.evaluate(SECRET_FIELD):
                raise BrowserError("That is a password, card or two-step code box: botdot never lets you type into it. "
                                "Click it and use type_login, type_card or type_identity, which type the saved value for you.")
            fill_like_a_person(page, element, str(req.get("text") or ""))
        elif op == "select":
            page, element = locate(context, req.get("ref"))
            choice = str(req.get("option") or "")
            try:  # by what the list shows, else by its value
                element.select_option(label=choice, timeout=5000)
            except Exception:
                element.select_option(value=choice, timeout=5000)
            settle(page)
        elif op == "find":
            text = str(req.get("text") or "").strip()
            if not text:
                raise BrowserError("Say which text to find.")
            full = page_snapshot(page, cap=FULL_CAP)
            head, _, tree = full.partition("\n")
            found = [line for line in tree.splitlines() if text.lower() in line.lower()]
            shown = "\n".join(found[:FIND_LINES]) or f'Nothing on the page says "{text}".'
            if len(found) > FIND_LINES:
                shown += f"\n({len(found) - FIND_LINES} more: find something narrower.)"
            # `page`: the whole page read, for botdot's irreversible-step checks (ADR 107), which the bot's refs are of
            return {"ok": True, "snapshot": f"{head}\n{shown}", "page": full}
        elif op == "press":
            page.keyboard.press(str(req.get("key") or ""))
            settle(page)
        elif op == "goto":
            url = str(req.get("url") or "")
            if urlparse(url).scheme not in ("http", "https"):
                raise BrowserError("browser_goto takes an http or https address.")
            try:
                page.goto(url, wait_until="domcontentloaded", timeout=15000)
            except Exception as exc:  # a slow site: what it shows so far, instead of nothing (#875)
                if type(exc).__name__ != "TimeoutError":
                    raise
                note = "The page did not finish loading in 15 s: this is what it shows so far.\n"
        elif op == "wait":
            if req.get("ref"):
                page, element = locate(context, req.get("ref"))
            elif req.get("text"):
                element = page.get_by_text(str(req["text"])).first
            else:
                raise BrowserError("Say which text or ref to wait for.")
            seconds = min(max(float(req.get("seconds") or 10), 1), 15)
            try:
                element.wait_for(state="visible", timeout=seconds * 1000)
            except Exception:
                raise BrowserError(f"It did not show within {seconds:g} seconds.")
        try:
            snapshot = page_snapshot(focused_page(context) or page)
        except BrowserError:
            if op == "snapshot":
                raise
            # The step was done: said as done, so the bot does not do it a second time (an order, a message). `unread`:
            # no page was read, so botdot keeps the last one it read for its irreversible-step checks (ADR 107).
            return {"ok": True, "unread": True, "snapshot": f"{note}Done, but the page is still changing, so it could not be read yet. Take a browser_snapshot in a moment."}
        if note:  # after its first line, "Page: <title> (<url>)", which tells botdot the site (lib/irreversible-steps.js)
            first, _, rest = snapshot.partition("\n")
            snapshot = f"{first}\n{note.rstrip()}" + (f"\n{rest}" if rest else "")
        return {"ok": True, "snapshot": snapshot}
    except BrowserError as exc:
        return {"ok": False, "error": str(exc)}
    except Exception as exc:  # Playwright's own words, first line only: it may hold the page's text, never a secret
        said = str(exc).strip().splitlines()[0][:300] if str(exc).strip() else ""
        covered = " Something covers it (a pop-up, a cookie banner?): close that first." if "intercepts pointer events" in str(exc) else ""
        return {"ok": False, "error": f"{op} failed: {type(exc).__name__}{': ' + said if said else ''}{covered}"}


def ask_bridge(body, port):
    """Ask a screen's bridge, on its port: its answer, or {} when none came."""
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{port}", json.dumps(body).encode(), {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=40) as res:
            answer = json.loads(res.read())
            return answer if isinstance(answer, dict) else {}
    except (OSError, ValueError):
        return {}


def bridge_running():
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
        try:
            probe.connect(BRIDGE_SOCKET)
            return True
        except OSError:
            return False


def keep_tail(f, size):
    """Shrink the open file f to its last `size` bytes, from the start of a line."""
    f.seek(max(0, os.fstat(f.fileno()).st_size - size))
    tail = f.read()
    cut = tail.find(b"\n")
    if f.tell() > len(tail) and 0 <= cut < len(tail) - 1:
        tail = tail[cut + 1:]
    f.seek(0)
    f.write(tail)
    f.truncate()


def bound_log():
    """Point this process's stdout and stderr, which Camoufox's processes inherit, at BRIDGE_LOG through a pipe,
    keeping the previous run as BRIDGE_LOG.1 and the live log under LOG_CAP. Called once this process is the
    bridge. If the log cannot be set up, the bridge runs on without it."""
    old = BRIDGE_LOG + ".1"
    try:
        os.replace(BRIDGE_LOG, old)
        with open(old, "r+b") as f:  # a log from before #355 may be any size
            if os.fstat(f.fileno()).st_size > LOG_CAP:
                keep_tail(f, LOG_CAP)
    except OSError:
        pass
    try:
        read_end, write_end = os.pipe()
    except OSError:
        return
    try:
        log = open(BRIDGE_LOG, "w+b", buffering=0)
    except OSError:
        os.close(read_end)
        os.close(write_end)
        return
    for stream in (sys.stdout, sys.stderr):
        if stream:
            stream.flush()
    os.dup2(write_end, 1)
    os.dup2(write_end, 2)
    os.close(write_end)

    def copy():
        size = 0
        while True:
            try:
                chunk = os.read(read_end, min(65536, LOG_CAP))
            except OSError:
                return
            if not chunk:
                return
            try:  # a full disk loses lines, never blocks the writers: the pipe is read on regardless
                if size + len(chunk) > LOG_CAP:  # trimmed to half, so the trimming is rare
                    keep_tail(log, min(LOG_CAP // 2, LOG_CAP - len(chunk)))
                log.write(chunk)
                size = log.tell()
            except Exception:
                pass

    copier = threading.Thread(target=copy, daemon=True)
    copier.start()

    def drain():
        """At exit, as after a crash, let the copy reach the log: what the bridge printed last tells why."""
        for stream in (sys.stdout, sys.stderr):
            if stream:
                stream.flush()
        null = os.open(os.devnull, os.O_WRONLY)
        os.dup2(null, 1)
        os.dup2(null, 2)
        copier.join(2)  # a Camoufox process still holding the pipe keeps it open: do not wait for it

    atexit.register(drain)


serve_lock = None  # held for the bridge's whole life: a second start beside it ends at once


def serve():
    """Serve botdot and the desktop until the computer stops, with Camoufox open whenever a page was asked for."""
    global serve_lock
    # One bridge a screen, also when botdot starts it again while one starts or runs without its socket: a second
    # would take the socket from the first and leave the browser on the other, so every browser tool says "not open".
    try:
        serve_lock = open(BRIDGE_SOCKET + ".lock", "a")
    except OSError:  # no folder for it: the socket fails below, and its traceback reaches the log
        serve_lock = None
    if serve_lock is not None:
        try:
            fcntl.flock(serve_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:  # another bridge of this screen holds it
            return
    if bridge_running():  # botdot started it again while it runs
        return
    bound_log()
    global proxy
    proxy = load_proxy()  # the one botdot gave last, until it gives another
    if proxy:
        serve_forwarder()
    try:
        os.unlink(BRIDGE_SOCKET)
    except FileNotFoundError:
        pass
    bridge = socketserver.ThreadingUnixStreamServer(BRIDGE_SOCKET, BridgeHandler)
    os.chmod(BRIDGE_SOCKET, 0o600)
    threading.Thread(target=bridge.serve_forever, daemon=True).start()
    try:
        opener = ThreadingHTTPServer(("127.0.0.1", OPEN_PORT), OpenHandler)
        threading.Thread(target=opener.serve_forever, daemon=True).start()
    except OSError:  # taken by a program of the bot: it gets no secret, only no browser
        print(f"camoufox-browser: 127.0.0.1:{OPEN_PORT} is taken, so the desktop cannot open pages", file=sys.stderr, flush=True)
    while True:
        body, reply = requests.get()
        body.pop("_until", None)
        if body.get("op") == "open":
            browser_starting.set()
            try:
                run_browser(body.get("url") or "about:blank")
            except ProxyDown as exc:
                global start_error
                with proxy_lock:
                    name = proxy["name"] if proxy else "The proxy"
                start_error = f"The proxy {name} {exc}, so the browser stayed closed. Nothing went out directly."
                say(start_error)
            except Exception as exc:  # e.g. the desktop is not up yet: the next open tries again
                print(f"camoufox-browser: Camoufox did not start: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
            finally:
                browser_starting.clear()
        elif reply is not None:
            reply.put(NOT_OPEN)
        body.clear()


# ---------- the bot's proxy (ADR 171) ----------

PROXY_TYPES = ("socks5", "http")
PROXY_HOST = re.compile(r"^[A-Za-z0-9._:\-]{1,253}$")
PROXY_SECONDS = 15  # the most one connection waits for the proxy
EXIT_SECONDS = 8  # the most a start waits to learn the proxy's address
IP_SITE = "api.ipify.org"
SOCKS_SAID = {1: "a failure", 2: "its rules", 3: "no network", 4: "no such host", 5: "a refusal", 6: "a timeout", 7: "no CONNECT", 8: "no such address type"}
proxy = None  # the bot's proxy: {"type", "host", "port", "username", "password", "name"}, or None
proxy_lock = threading.Lock()
forwarder = None
start_error = None  # why the last start did not open the browser, for --is-open


class ProxyDown(Exception):
    """The proxy did not take a connection: what it said, in a few words, never its login."""


def clean_proxy(value):
    """A proxy as botdot sends it, or None. Raises ValueError for one that isn't."""
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ValueError("a proxy is an object")
    kind, host, port = value.get("type"), str(value.get("host") or "").strip("[]"), value.get("port")
    if kind not in PROXY_TYPES or not PROXY_HOST.match(host) or not isinstance(port, int) or isinstance(port, bool) or not 0 < port < 65536:
        raise ValueError("a proxy has a type (socks5 or http), a host and a port")
    username, password = str(value.get("username") or ""), str(value.get("password") or "")
    if len(username) > 255 or len(password) > 255:
        raise ValueError("a proxy's login has at most 255 characters")
    return {"type": kind, "host": host, "port": port, "username": username, "password": password, "name": str(value.get("name") or host)[:60]}


def load_proxy():
    """The proxy kept for this screen's bot, or None (no file, another bot's, or not one)."""
    try:
        with open(PROXY_FILE) as f:
            kept = json.load(f)
        return clean_proxy(kept.get("proxy")) if isinstance(kept, dict) and kept.get("bot") == BOT else None
    except (OSError, ValueError):
        return None


def take_proxy(value):
    """botdot's {"op": "proxy"}: keep it for the next start, and close a browser that runs on another one, so the bot's
    next open_browser starts it on this one. The answer says it was taken (an older bridge answers otherwise)."""
    global proxy
    try:
        new = clean_proxy(value)
    except ValueError as exc:
        return {"ok": False, "error": str(exc)}
    try:
        if new is None:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(PROXY_FILE)
        else:
            fd = os.open(PROXY_FILE + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump({"bot": BOT, "proxy": new}, f)
            os.replace(PROXY_FILE + ".tmp", PROXY_FILE)
    except OSError as exc:
        return {"ok": False, "error": f"The bridge couldn't keep the proxy: {type(exc).__name__}"}
    with proxy_lock:
        changed, proxy = new != proxy, new
    if new is not None:
        serve_forwarder()
    if changed and (browser_open.is_set() or browser_starting.is_set()):
        requests.put(({"op": "close"}, None))
    return {"ok": True, "proxyTaken": True, "proxy": "set" if new else "none"}


def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ProxyDown("closed the connection")
        data += chunk
    return data


def socks_address(host):
    try:
        ip = ipaddress.ip_address(host)
        return (b"\x01" if ip.version == 4 else b"\x04") + ip.packed
    except ValueError:
        name = host.encode("idna")
        if not 0 < len(name) < 256:
            raise ProxyDown("can't take so long a name")
        return b"\x03" + bytes([len(name)]) + name


def socks_connect(sock, p, host, port):
    signs_in = bool(p["username"])
    sock.sendall(b"\x05\x02\x00\x02" if signs_in else b"\x05\x01\x00")
    version, method = recv_exact(sock, 2)
    if version != 5:
        raise ProxyDown("is not a SOCKS5 proxy")
    if method == 2 and signs_in:
        user, word = p["username"].encode(), p["password"].encode()
        sock.sendall(bytes([1, len(user)]) + user + bytes([len(word)]) + word)
        if recv_exact(sock, 2)[1] != 0:
            raise ProxyDown("refused the login")
    elif method != 0:
        raise ProxyDown("refused the login" if signs_in else "wants a login")
    sock.sendall(b"\x05\x01\x00" + socks_address(host) + struct.pack(">H", port))
    _, reply, _, kind = recv_exact(sock, 4)
    if reply != 0:
        raise ProxyDown(f"didn't reach {host}: {SOCKS_SAID.get(reply, reply)}")
    size = {1: 4, 4: 16}.get(kind)
    recv_exact(sock, (recv_exact(sock, 1)[0] if size is None else size) + 2)


def http_connect(sock, p, host, port):
    target = f"[{host}]:{port}" if ":" in host else f"{host}:{port}"
    head = f"CONNECT {target} HTTP/1.1\r\nHost: {target}\r\n"
    if p["username"]:
        head += "Proxy-Authorization: Basic " + base64.b64encode(f'{p["username"]}:{p["password"]}'.encode()).decode() + "\r\n"
    sock.sendall((head + "\r\n").encode())
    answer = b""
    while b"\r\n\r\n" not in answer:  # it says nothing more before the client speaks in the tunnel
        chunk = sock.recv(4096)
        if not chunk:
            raise ProxyDown("closed the connection")
        answer += chunk
        if len(answer) > 65536:
            raise ProxyDown("gave an answer too long")
    words = answer.split(b"\r\n", 1)[0].split()
    code = words[1].decode("ascii", "replace") if len(words) > 1 else "?"
    if code == "407":
        raise ProxyDown("refused the login")
    if code != "200":
        raise ProxyDown(f"answered {code} for {host}")


def through(p, host, port, seconds=PROXY_SECONDS):
    """A connection to host:port through proxy p, the host's name resolved by the proxy, never here."""
    try:
        sock = socket.create_connection((p["host"], p["port"]), timeout=seconds)
    except OSError as exc:
        raise ProxyDown(f"didn't answer ({type(exc).__name__})")
    try:
        (socks_connect if p["type"] == "socks5" else http_connect)(sock, p, host, port)
    except ProxyDown:
        sock.close()
        raise
    except OSError as exc:
        sock.close()
        raise ProxyDown(f"didn't answer ({type(exc).__name__})")
    sock.settimeout(None)
    return sock


def exit_ip(p, seconds=EXIT_SECONDS):
    """The address sites see through proxy p (Camoufox's geoip then matches it), or ProxyDown."""
    sock = through(p, IP_SITE, 443, seconds)
    sock.settimeout(seconds)
    try:
        import certifi
        context = ssl.create_default_context(cafile=certifi.where())
    except ImportError:
        context = ssl.create_default_context()
    try:
        with context.wrap_socket(sock, server_hostname=IP_SITE) as tls:
            tls.sendall(f"GET / HTTP/1.0\r\nHost: {IP_SITE}\r\nUser-Agent: Mozilla/5.0\r\n\r\n".encode())
            data = b""
            while len(data) < 65536:
                chunk = tls.recv(4096)
                if not chunk:
                    break
                data += chunk
    except (OSError, ssl.SSLError) as exc:
        raise ProxyDown(f"didn't carry the connection ({type(exc).__name__})")
    finally:
        sock.close()
    try:
        return str(ipaddress.ip_address(data.split(b"\r\n\r\n", 1)[-1].strip().decode("ascii")))
    except (ValueError, UnicodeDecodeError):
        raise ProxyDown("gave no address")


def pipe(a, b):
    """Copy a to b until either side ends, then end both."""
    try:
        while True:
            chunk = a.recv(65536)
            if not chunk:
                break
            b.sendall(chunk)
    except OSError:
        pass
    for s in (a, b):
        with contextlib.suppress(OSError):
            s.shutdown(socket.SHUT_RDWR)


class ForwardHandler(socketserver.BaseRequestHandler):
    """The way into the bot's proxy on the loopback, which the bridge signs into: SOCKS5 without a login (CONNECT
    only) for Camoufox, and an HTTP proxy (CONNECT, and plain http:// requests) for the bot's commands, which more
    programs take than SOCKS. The site's name goes to the proxy as it came. Without a proxy nothing goes out."""

    def handle(self):
        client = self.request
        client.settimeout(PROXY_SECONDS)
        try:
            first = recv_exact(client, 1)
            upstream = self.socks(client) if first == b"\x05" else self.http(client, first)
        except (OSError, ProxyDown, ValueError, UnicodeError):
            return
        if upstream is None:
            return
        client.settimeout(None)
        back = threading.Thread(target=pipe, args=(upstream, client), daemon=True)
        back.start()
        pipe(client, upstream)
        back.join()
        upstream.close()

    @staticmethod
    def current():
        with proxy_lock:
            return proxy

    def socks(self, client):
        methods = recv_exact(client, recv_exact(client, 1)[0])
        if 0 not in methods:
            client.sendall(b"\x05\xff")
            return None
        client.sendall(b"\x05\x00")
        version, command, _, kind = recv_exact(client, 4)
        if kind == 1:
            host = str(ipaddress.IPv4Address(recv_exact(client, 4)))
        elif kind == 4:
            host = str(ipaddress.IPv6Address(recv_exact(client, 16)))
        elif kind == 3:
            host = recv_exact(client, recv_exact(client, 1)[0]).decode("idna")
        else:
            client.sendall(b"\x05\x08\x00\x01" + bytes(6))
            return None
        port = struct.unpack(">H", recv_exact(client, 2))[0]
        p = self.current()
        if version != 5 or command != 1:
            client.sendall(b"\x05\x07\x00\x01" + bytes(6))
            return None
        if p is None:  # no proxy now: nothing goes out directly
            client.sendall(b"\x05\x02\x00\x01" + bytes(6))
            return None
        try:
            upstream = through(p, host, port)
        except ProxyDown:
            client.sendall(b"\x05\x05\x00\x01" + bytes(6))
            return None
        client.sendall(b"\x05\x00\x00\x01" + bytes(6))
        return upstream

    def http(self, client, first):
        head = first
        while b"\r\n\r\n" not in head:
            chunk = client.recv(4096)
            if not chunk or len(head) > 65536:
                return None
            head += chunk
        head, body = head.split(b"\r\n\r\n", 1)
        line, _, rest = head.partition(b"\r\n")
        words = line.decode("latin-1").split()
        if len(words) != 3:
            return None
        method, target, version = words
        p = self.current()
        if p is None:
            client.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            return None
        if method == "CONNECT":
            host, _, port = target.rpartition(":")
            host, port = host.strip("[]"), int(port)
        else:
            url = urlparse(target)
            if url.scheme != "http" or not url.hostname:
                client.sendall(b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                return None
            host, port = url.hostname, url.port or 80
        try:
            upstream = through(p, host, port)
        except ProxyDown:
            client.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            return None
        if method == "CONNECT":
            client.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
            return upstream
        path = (url.path or "/") + (f"?{url.query}" if url.query else "")
        kept = [h for h in rest.split(b"\r\n") if h and not h.lower().startswith((b"proxy-connection:", b"proxy-authorization:"))]
        upstream.sendall(f"{method} {path} {version}\r\n".encode("latin-1") + b"".join(h + b"\r\n" for h in kept) + b"\r\n" + body)
        return upstream


class Forwarder(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def serve_forwarder():
    """The forwarder, started once: True when it listens."""
    global forwarder
    with proxy_lock:
        if forwarder is not None:
            return True
        try:
            forwarder = Forwarder(("127.0.0.1", PROXY_PORT), ForwardHandler)
        except OSError:  # taken by a program of a bot: the browser then doesn't start with the proxy
            say(f"127.0.0.1:{PROXY_PORT} is taken, so the browser can't use the bot's proxy")
            return False
    threading.Thread(target=forwarder.serve_forever, daemon=True).start()
    return True


def proxied_options(options, p):
    """Camoufox's options for proxy p: through the forwarder, with DNS at the proxy and WebRTC only through it, and
    the address sites see for geoip. Raises ProxyDown when the proxy doesn't carry a connection."""
    if not serve_forwarder():
        raise ProxyDown(f"can't be used: 127.0.0.1:{PROXY_PORT} is taken on this computer")
    ip = exit_ip(p)
    options["proxy"] = {"server": f"socks5://127.0.0.1:{PROXY_PORT}"}
    options["firefox_user_prefs"].update({
        "network.proxy.socks_remote_dns": True,  # a site's name is resolved by the proxy, not here
        "network.trr.mode": 5,  # no DNS over HTTPS beside it
        "network.dns.disablePrefetch": True,
        "media.peerconnection.ice.proxy_only": True,  # WebRTC only through the proxy, never this computer's address
        "media.peerconnection.ice.default_address_only": True,
        "media.peerconnection.ice.no_host": True,
    })
    return ip


IDENTITY_FILE = "botdot-identity.json"  # in the bot's profile: deleting the bot, or its profile, gives it a new one
SCREEN = (1024, 768)
WINDOW = (1024, 740)
# The owner's language, as lib/browser-locale.js gives it (en-US, pl-PL): a page's language, number and date formats.
LOCALE = re.compile(r"^[a-z]{2,3}-[A-Z]{2}$")
geoip_failed_at = None
GEOIP_SECONDS = 6  # the most a start waits for the computer's address


def say(text):
    print(f"camoufox-browser: {text}", file=sys.stderr, flush=True)


def lasting_identity(Screen):
    """The bot's own browser identity (an fpgen fingerprint), the same at every start: a site that sees the same
    visitor come back with another screen, GPU and fonts each time takes it for a bot. Made at the first start and
    kept in the profile. None on a Camoufox without generate_fingerprint (0.5.6) or when it can't be made: then
    Camoufox makes one for this start, as before."""
    path = os.path.join(PROFILE, IDENTITY_FILE)
    try:
        with open(path) as f:
            kept = json.load(f)
        if isinstance(kept, dict) and kept.get("navigator"):
            return kept
    except (OSError, ValueError):
        pass
    try:
        from camoufox.fingerprints import generate_fingerprint
        made = generate_fingerprint(screen=Screen(max_width=SCREEN[0], max_height=SCREEN[1]), window=WINDOW, os="linux")
        text = json.dumps(made)
        fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
        return json.loads(text)  # as it is read back next time, so every start has the same identity, salt and all
    except Exception as exc:
        say(f"no lasting identity, a new one this start: {type(exc).__name__}")
        return None


def where_from():
    """This computer's public address when Camoufox can place it, for geoip: the time zone, position and WebRTC
    address a site sees then agree with where its traffic comes from. None when it can't (no network, no database):
    the browser then starts without it, and tries again ten minutes later, so a computer without network doesn't wait
    for the address at every start."""
    global geoip_failed_at
    if geoip_failed_at is not None and time.monotonic() - geoip_failed_at < 600:
        return None
    try:
        from camoufox.ip import public_ip
        return placed(public_ip())
    except Exception as exc:
        geoip_failed_at = time.monotonic()
        say(f"started without geoip: {type(exc).__name__}")
        return None


def placed(ip):
    """ip, once Camoufox's database places it (it raises when it can't)."""
    from camoufox import geolocation
    # The database comes with the desktop (deploy/desktop/Dockerfile) in a folder this user can't write: an older
    # one is used as it is, instead of downloading a new one at every start that can't be saved.
    geolocation.needs_update = lambda *args, **kwargs: False
    geolocation.geoip_allowed()
    geolocation.get_geolocation(ip)
    return ip


def where_from_quickly(seconds=GEOIP_SECONDS):
    """where_from, waited on for `seconds` at most: a slow network doesn't hold the browser's start. One that answers
    later is kept by Camoufox (public_ip is cached), so the next start has it."""
    found = []
    asking = threading.Thread(target=lambda: found.append(where_from()), daemon=True)
    asking.start()
    asking.join(seconds)
    if not found:
        say("started without geoip: the address took too long")
    return found[0] if found else None


def run_browser(url):
    """Camoufox at url, serving the queued requests on this thread until its window is closed."""
    # Imported here, so a broken Camoufox is told in the bridge's log instead of ending the bridge before it has one
    try:
        from camoufox.fingerprints import Screen  # Camoufox 0.5.9 and later
    except ImportError:  # 0.5.6: botdot copies this file into computers still on an older desktop until their Update
        from browserforge.fingerprints import Screen
    from camoufox.sync_api import Camoufox

    os.makedirs(PROFILE, mode=0o700, exist_ok=True)
    options = dict(
        headless=False,
        persistent_context=True,
        user_data_dir=PROFILE,
        os="linux",                      # match the real machine so fonts and platform agree
        screen=Screen(max_width=SCREEN[0], max_height=SCREEN[1]),
        window=WINDOW,
        humanize=0.5,                    # human-like cursor movement, up to 0.5 s a move instead of 1.5 s
        firefox_user_prefs={
            "signon.rememberSignons": False,  # never store typed passwords in the profile
            "signon.autofillForms": False,
            # The bot's own folder, which the browser user may write into (deploy/desktop/Dockerfile): the bot
            # reads what it downloads, and this user's home stays closed to it.
            "browser.download.dir": DOWNLOADS,
            "browser.download.folderList": 2,
            # Less memory (#152): gVisor never gives back what the browser once took, and the guest sees all of
            # the machine's RAM, so Firefox never thinks memory is short. One content process for every site, no
            # spare one kept waiting, networking in the main process, and small caches.
            "fission.autostart": False,
            "dom.ipc.processCount": 1,
            "dom.ipc.processPrelaunch.enabled": False,
            "network.process.enabled": False,
            "browser.cache.memory.capacity": 16384,  # KB, instead of sized from the machine's RAM
            "browser.sessionhistory.max_total_viewers": 0,  # Back loads the page again instead of keeping it
        },
    )
    who = {}
    identity = lasting_identity(Screen)
    if identity:
        who["fingerprint"] = identity
    with proxy_lock:
        through_proxy = proxy
    if through_proxy:  # its place is the proxy's: raises when the proxy doesn't answer, and nothing starts
        ip = proxied_options(options, through_proxy)
        try:
            who["geoip"] = placed(ip)
        except Exception as exc:
            say(f"started without geoip: {type(exc).__name__}")
    else:
        ip = where_from_quickly()
        if ip:
            who["geoip"] = ip
    locale = os.environ.get("BOTDOT_LOCALE", "")
    if LOCALE.match(locale):  # after geoip, which would otherwise give the language of the server's country
        who["locale"] = locale
    with contextlib.ExitStack() as stack:
        try:
            context = stack.enter_context(Camoufox(**options, **who))
        except Exception as exc:
            if not who:
                raise
            # The bot's browser opens all the same, as before: without them. A kept identity that this Camoufox no
            # longer takes is put aside, so the next start makes a new one instead of failing first every time.
            say(f"Camoufox did not start with the bot's identity, place and language ({type(exc).__name__}), so it starts without them")
            context = stack.enter_context(Camoufox(**options))
            # Only an error in what Camoufox was given (raised before Firefox starts) is the identity's: a crash or a
            # timeout of the start is not, and the identity stays.
            if identity and (isinstance(exc, (ValueError, TypeError, KeyError)) or type(exc).__name__ == "NonFirefoxFingerprint"):
                try:
                    os.replace(os.path.join(PROFILE, IDENTITY_FILE), os.path.join(PROFILE, IDENTITY_FILE + ".unused"))
                except OSError:
                    pass
        try:
            closed = threading.Event()
            context.on("close", lambda *_: closed.set())
            page = context.pages[0] if context.pages else context.new_page()
            if url != "about:blank":  # the first page is already blank; going there again races and crashes
                try:
                    page.goto(url, wait_until="domcontentloaded", timeout=15000)
                except Exception as exc:  # a slow or failing site leaves the browser open on what it reached (#875)
                    say(f"the first page did not load: {type(exc).__name__}")
            # Open only while Camoufox runs (#875): whatever ends it, the next is-open says no, so open_browser starts
            # it again instead of answering "already open" for a window that is gone. Said once its first page is
            # there, so open_browser reads that page, not a blank one; from then on an open is a tab of its own.
            browser_open.set()
            browser_starting.clear()
            # Serve secret-typing requests on this thread (Playwright's sync API isn't thread-safe)
            # until the window is closed.
            while not closed.is_set():
                try:  # a request is taken the moment it comes, not at the next 200 ms tick
                    body, reply = requests.get(timeout=0.2)
                except queue.Empty:
                    try:
                        pages = context.pages
                        if not pages:
                            break
                        pages[0].wait_for_timeout(1)  # lets Playwright process events
                    except Exception:
                        break
                    continue
                if body.get("op") == "close":  # its proxy changed: the next open starts it on the new one
                    body.clear()
                    break
                until = body.pop("_until", None)
                if until is not None and time.monotonic() > until - START_SECONDS:
                    body.clear()
                    if reply is not None:
                        reply.put(BUSY)
                    continue
                try:
                    result = browser_tool(context, body) if body.get("op") in BROWSER_OPS else type_secret(context, body)
                except Exception as exc:  # report the problem, never the value
                    result = {"ok": False, "error": f"The browser failed: {type(exc).__name__}"}
                finally:
                    body.clear()
                if reply is not None:
                    reply.put(result)
        finally:
            browser_open.clear()


def main():
    if sys.argv[1:2] == ["--serve"]:
        if len(sys.argv) > 2:  # a bot's screen (#105); without, the one shared screen of before
            for_screen(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "")
        serve()
        return
    port = port_of_display(os.environ.get("DISPLAY"))
    if sys.argv[1:2] == ["--is-open"]:
        said = ask_bridge({"op": "is-open"}, port)
        if said.get("open"):
            sys.exit(0)
        if said.get("error"):
            print(said["error"])
        sys.exit(1)
    url = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else "about:blank"
    if not ask_bridge({"op": "open", "url": url}, port).get("ok", False):
        print("botdot's browser is not running on this screen.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
