#!/bin/sh
# A bot's screen session (#134): the XFCE window manager alone, in place of the whole XFCE session (panel, desktop,
# settings daemon, session manager), which Camoufox and the programs a bot starts don't need. Measured with TigerVNC
# and a terminal open: 184 MB instead of 406 MB a screen. Windows keep their title bars, so the owner can still move
# and close them in the live view.
unset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS
# lint-ignore: error-masking
command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#2e3440' || true
exec dbus-launch --exit-with-session xfwm4 --compositor=off
