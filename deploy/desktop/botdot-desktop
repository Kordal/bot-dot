#!/bin/sh
# One bot's desktop as box (#311, #105), in place of cua's /opt/desktop/start.sh, which keeps it in /root:
# TigerVNC with XFCE's window manager alone on the screen's own display (SCREEN_DISPLAY, VNC port VNC_PORT, from
# deploy/desktop/botdot-screen.conf; the session is /usr/local/bin/botdot-xstartup, #134), the browser user let onto
# that display to show Camoufox, and cua's window theme.
# It then follows the screen's VNC log, so that supervisord sees it running.
set -eu

DISPLAY_NUM="${SCREEN_DISPLAY:-:1}"
N="${DISPLAY_NUM#:}"
# lint-ignore: error-masking
rm -f "/tmp/.X$N-lock" "/tmp/.X11-unix/X$N" 2>/dev/null || true

mkdir -p "$HOME/.vnc"
cp /usr/local/bin/botdot-xstartup "$HOME/.vnc/xstartup"
chmod +x "$HOME/.vnc/xstartup"

vncserver "$DISPLAY_NUM" -geometry 1024x768 -depth 24 -rfbport "${VNC_PORT:-5901}" \
    -SecurityTypes None --I-KNOW-THIS-IS-INSECURE -localhost no

for _ in $(seq 1 40); do
    [ -e "/tmp/.X11-unix/X$N" ] && break
    sleep 0.5
done

export DISPLAY="$DISPLAY_NUM"
export XAUTHORITY="$HOME/.Xauthority"
# Camoufox runs as the browser user, which has no cookie for this display: let that user in by name.
xhost +SI:localuser:browser

sleep 6
# lint-ignore: error-masking
xfconf-query -c xfwm4 -p /general/theme -s Greybird 2>/dev/null || true

VNC_LOG="$(ls -t "$HOME"/.vnc/*"$DISPLAY_NUM".log 2>/dev/null | head -1)"
exec tail -F "${VNC_LOG:-/dev/null}"
