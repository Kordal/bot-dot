#!/usr/bin/python3 -I
"""Reads {"op","site","field","value","submit"} as JSON on stdin and hands it to botdot's bridge in Camoufox
(camoufox-browser --serve), over the bridge's socket, which only the browser user can open.
botdot sends this file's own copy with every call and runs it as that user (lib/computers.js typeSecret), so
nothing in the computer can change it, and the value never appears in a command line. It sends nothing unless
the program answering is the browser user's own (#311)."""
import json
import os
import socket
import struct
import sys

BRIDGE_SOCKET = sys.argv[1] if len(sys.argv) > 1 else "/run/botdot-browser/bridge.sock"

try:
    body = sys.stdin.buffer.read()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as bridge:
        bridge.settimeout(40)
        bridge.connect(BRIDGE_SOCKET)
        _pid, uid, _gid = struct.unpack("3i", bridge.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        if uid != os.getuid():
            raise PermissionError("the bridge is not the browser user's")
        bridge.sendall(body)
        bridge.shutdown(socket.SHUT_WR)
        reply = b"".join(iter(lambda: bridge.recv(65536), b""))
    print(reply.decode())
except Exception:
    print(json.dumps({"ok": False, "error": "Camoufox isn't open. Open the site with open_browser first."}))
