#!/usr/bin/python3 -I
"""What a command of botdot's starts on the account's computer ends with it (#535).

botdot-run [--keep] [--screen <n>] [--run <id>] [--memory <bytes>] [--seconds <n>] [--commands <regex>] [--grace <seconds>] -- <command>...

Runs the command as its child and makes itself the subreaper of all it starts (PR_SET_CHILD_SUBREAPER): a process
whose parent died comes to it, also one that left with setsid or nohup, and it reaps each one that ends, so no zombie
stays behind on PID 1, which on a computer made before #535 is `sleep` and never reaps.
Without --keep (a bot's command, a screen's supervisord, a browser's bridge) everything still left when the command
ends is ended: SIGTERM, then SIGKILL after a moment. What runs as another user (root, through sudo) goes on: it is the
computer's own, such as its Tailscale. With --keep (start_program) it stays while anything it started runs, for a
program that forks and lets its first process go. A SIGTERM, SIGINT or SIGHUP goes to the command first and
then ends the rest the same way. --screen names the bot's screen (its display's number) on the command line, so that
the end of that screen finds what runs for it (lib/computers.js STOP_SCREEN), and --run names the bot's run, so that the
end of that run finds its commands (lib/computers.js endRun). Exits as the command did.
--memory ends the command with all it started, once together they hold more than that much, and it exits with 137 and
says so on stderr. There are no cgroups per command under gVisor, and RLIMIT_AS would stop a Node.js or a browser long
before it held anything, as they reserve far more address space than they use (ADR 131).
With --commands, the command itself is a long-lived program that runs shorter ones (Claude Code in the bot-dot
container, ADR 131): each child of it whose command line matches the regex, and each process that lost its parent and
came here, is one command, and --memory and --seconds hold for each of them apart, leaving the program running. The
one ended is told on its own stderr, which is what the bot reads.
botdot sends this file's own copy with every call (lib/computers.js reaped), so it needs no file in the computer."""
import ctypes
import os
import re
import select
import signal
import sys
import time

PR_SET_CHILD_SUBREAPER = 36
GRACE = 2.0  # how long the command has to end after a signal, and the rest after SIGTERM, before SIGKILL
CHECK_EVERY = 2.0  # how often the limits are read: each reading walks /proc
PAGE = os.sysconf("SC_PAGE_SIZE")


def options(argv):
    o = {"keep": False, "memory": 0, "seconds": 0, "commands": None, "grace": GRACE}
    i = 0
    while i < len(argv) and argv[i] != "--":
        if argv[i] == "--keep":
            o["keep"] = True
            i += 1
        elif argv[i] in ("--screen", "--run") and i + 1 < len(argv):
            i += 2
        elif argv[i] in ("--memory", "--seconds") and i + 1 < len(argv):
            o[argv[i][2:]] = int(argv[i + 1])
            i += 2
        elif argv[i] == "--commands" and i + 1 < len(argv):
            o["commands"] = re.compile(argv[i + 1])
            i += 2
        elif argv[i] == "--grace" and i + 1 < len(argv):
            o["grace"] = float(argv[i + 1])
            i += 2
        else:
            raise SystemExit(f"botdot-run: unknown option {argv[i]}")
    command = argv[i + 1:]
    if not command:
        raise SystemExit("botdot-run takes a command after --")
    return o, command


def table():
    """Every live process: pid -> (parent, whether it is this user's, resident bytes). A zombie is left out: its parent
    reaps it."""
    out = {}
    uid = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/stat", "rb") as f:
                rest = f.read().rsplit(b")", 1)[1].split()
            owner = os.stat(f"/proc/{pid}").st_uid
        except (OSError, IndexError):
            continue
        if rest and rest[0] != b"Z":
            out[int(pid)] = (int(rest[1]), uid == 0 or owner == uid, int(rest[21]) * PAGE)
    return out


def under(procs, roots):
    """The processes in `procs` at or below `roots`."""
    found = {pid for pid in roots if pid in procs}
    grew = True
    while grew:
        grew = False
        for pid, entry in procs.items():
            if pid not in found and entry[0] in found:
                found.add(pid)
                grew = True
    return found


def descendants():
    """The live processes under this one, at any depth, that are its own user's: what a command started as root through
    sudo (a daemon such as the computer's Tailscale) is the computer's own and goes on."""
    procs = table()
    me = os.getpid()
    return {pid for pid in under(procs, {pid for pid, p in procs.items() if p[0] == me}) if procs[pid][1]}


def reap():
    """Every child that ended, reaped: their exit statuses by pid, and whether no child is left at all."""
    ended = {}
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return ended, True
        if pid == 0:
            return ended, False
        ended[pid] = status


def signal_all(pids, sig):
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def size(bytes_):
    return f"{bytes_ / 1e9:.1f} GB"


def over(limits, rss, ran):
    """Why a command that holds `rss` bytes and has run `ran` seconds must end, in words, or None."""
    if limits["memory"] and rss > limits["memory"]:
        return f"used more than {size(limits['memory'])} of memory"
    if limits["seconds"] and ran > limits["seconds"]:
        return f"ran for more than {limits['seconds']} seconds"
    return None


def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return ""


class Commands:
    """The commands of a long-lived program (--commands), each held to the limits apart."""

    def __init__(self, program, limits):
        self.program = program
        self.limits = limits
        self.first_seen = {}  # a command's pid -> when it was first seen
        self.ending = {}  # a command's pid -> when it was sent SIGTERM

    def check(self):
        procs = table()
        me = os.getpid()
        now = time.monotonic()
        roots = [pid for pid, p in procs.items()
                 if p[0] == me and pid != self.program
                 or p[0] == self.program and self.limits["commands"].search(cmdline(pid))]
        for pid in list(self.first_seen):
            if pid not in roots:
                del self.first_seen[pid]
                self.ending.pop(pid, None)
        for pid in roots:
            ran = now - self.first_seen.setdefault(pid, now)
            tree = {p for p in under(procs, {pid}) if procs[p][1]}
            if pid in self.ending:
                if now - self.ending[pid] > self.limits["grace"]:
                    signal_all(tree, signal.SIGKILL)
                continue
            why = over(self.limits, sum(procs[p][2] for p in tree), ran)
            if why:
                self.ending[pid] = now
                say = f"botdot: stopped: this command {why}, with all it started.\n"
                sys.stderr.write(say)
                try:
                    with open(f"/proc/{pid}/fd/2", "w") as f:
                        f.write(say)
                except OSError:
                    pass
                signal_all(tree, signal.SIGTERM)


def end_rest(grace=GRACE):
    """SIGTERM to all that is left, SIGKILL to what still runs after the grace, also to what was forked meanwhile."""
    told = set()
    killed = None  # when SIGKILL was first sent
    deadline = time.monotonic() + grace
    while True:
        reap()
        left = descendants()
        if not left:
            return
        if killed is None and time.monotonic() > deadline:
            killed = time.monotonic()
            told = set()
        if killed is not None and time.monotonic() > killed + grace:
            return  # what not even SIGKILL ended (a process stuck in the kernel) goes to PID 1
        signal_all(left - told, signal.SIGTERM if killed is None else signal.SIGKILL)
        told |= left
        time.sleep(0.05)


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "botdot-run":  # botdot's copy, run with python3 -c: its name comes first
        argv = argv[1:]
    limits, command = options(argv)
    keep = limits["keep"]
    grace = limits["grace"]
    limited = limits["memory"] or limits["seconds"]
    try:
        ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)
    except (OSError, AttributeError):
        pass  # without it, what leaves its parent still goes to PID 1; the rest of what it does holds
    # A signal is only noted, and wakes the loop below through the pipe, as a child's end does: the loop alone reaps,
    # so no exit status is lost to a signal that comes as the command ends.
    got = []
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    ending = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
    for sig in ending:
        signal.signal(sig, lambda signum, _frame: got.append(signum))
    signal.signal(signal.SIGCHLD, lambda *_: None)
    began = time.monotonic()
    child = os.fork()
    if child == 0:
        for sig in (*ending, signal.SIGCHLD):
            signal.signal(sig, signal.SIG_DFL)
        try:
            os.execvp(command[0], command)
        except OSError as e:
            sys.stderr.write(f"{command[0]}: {e.strerror}\n")
            os._exit(127)
    code = None
    held = Commands(child, limits) if limited and limits["commands"] else None
    stopped = None  # why the whole command was stopped, in words
    checked = time.monotonic()

    def wait(seconds):
        select.select([wake_r], [], [], seconds)
        try:
            os.read(wake_r, 4096)
        except BlockingIOError:
            pass

    os.set_blocking(wake_r, False)
    while True:
        ended, none_left = reap()
        if child in ended:
            code = os.waitstatus_to_exitcode(ended[child])
        if got or stopped or (code is not None and (not keep or none_left)):
            break
        if limited and time.monotonic() - checked >= CHECK_EVERY:
            checked = time.monotonic()
            if held:
                held.check()
            else:
                procs = table()
                tree = {p for p in under(procs, {child}) if procs[p][1]}
                stopped = over(limits, sum(procs[p][2] for p in tree), checked - began)
        wait(1.0)
    if stopped:
        sys.stderr.write(f"botdot: stopped: this command {stopped}, with all it started.\n")
        got.append(signal.SIGTERM)
    if got and code is None:
        signal_all([child], got[0])  # not reaped yet, so the pid is still the command's
        until = time.monotonic() + grace
        while code is None and time.monotonic() < until:
            ended, _ = reap()
            if child in ended:
                code = os.waitstatus_to_exitcode(ended[child])
            else:
                wait(0.05)
    end_rest(grace)
    if stopped:
        sys.exit(137)
    if code is None:
        code = 128 + got[0] if got else 1
    sys.exit(code if code >= 0 else 128 - code)


main()
