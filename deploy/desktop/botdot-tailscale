#!/usr/bin/python3 -I
"""Puts the account's computer on the owner's tailnet: one device for the whole computer, which every bot on it
uses, run by root (#106, ADR 035).

  botdot-tailscale up [NAME]   install Tailscale if missing, start it, and print the login link for the owner, or the
                               computer's tailnet address once it is signed in
  botdot-tailscale status      the tailnet as this computer sees it
  botdot-tailscale down        stop Tailscale on this computer (it stays signed in)
  botdot-tailscale resume      start Tailscale again if this computer is signed in, with no new login, and put its
                               shields back up: botdot runs it as root each time the computer starts (#68)

A bot runs it as box: it starts itself again through sudo. Tailscale, its state (the device's key and login) and its
socket are root's, in /var/lib/botdot-tailscale, which a program that does not use sudo cannot open; one that uses
sudo can (ADR 035).

Tailscale runs in userspace (--tun=userspace-networking): kernel mode would need NET_ADMIN and a TUN device in the
computer, and with NET_ADMIN root, which every bot is through sudo, could change botdot's firewall. Programs reach the
tailnet through its proxy on localhost:1055 (SOCKS5 and HTTP): ALL_PROXY=socks5h://localhost:1055. Incoming
connections are refused (--shields-up, set again at every start), and botdot's firewall drops what root sends to
botdot's control and screen ports on the loopback, where Tailscale would forward a tailnet connection, so no tailnet
device reaches them. No auth key: the owner opens the login link and approves the computer in their own Tailscale
admin console, so no secret passes through a bot.
"""
import base64, hashlib, json, os, platform, shutil, socket, subprocess, sys, tarfile, tempfile, time, urllib.request

PKGS = 'https://pkgs.tailscale.com/stable/'
DIR = '/var/lib/botdot-tailscale'
PROXY = 'localhost:1055'
ARCH = {'x86_64': 'amd64', 'amd64': 'amd64', 'aarch64': 'arm64', 'arm64': 'arm64'}
SUDO = '/usr/bin/sudo'
BOX = 'box'


def bin_dir():
    return os.path.join(DIR, 'bin')


def state_dir():
    return os.path.join(DIR, 'state')


def socket_path():
    return os.path.join(DIR, 'tailscaled.sock')


def installed():
    return all(os.access(os.path.join(bin_dir(), n), os.X_OK) for n in ('tailscale', 'tailscaled'))


def fetch(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read()


def own_dir():
    """root's folder, closed to every other user."""
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    os.chmod(DIR, 0o700)


def install():
    if installed():
        return
    arch = ARCH.get(platform.machine())
    if not arch:
        sys.exit(f'Tailscale has no build here for {platform.machine()}.')
    name = json.loads(fetch(PKGS + '?mode=json'))['Tarballs'][arch]
    print(f'Installing {name}…', flush=True)
    data = fetch(PKGS + name)
    want = fetch(PKGS + name + '.sha256').decode().split()[0].lower()
    if hashlib.sha256(data).hexdigest() != want:
        sys.exit(f'{name} does not match its published SHA-256: not installed.')
    own_dir()
    os.makedirs(bin_dir(), exist_ok=True)
    with tempfile.TemporaryDirectory(dir=DIR) as tmp:
        path = os.path.join(tmp, name)
        with open(path, 'wb') as f:
            f.write(data)
        with tarfile.open(path) as t:
            t.extractall(tmp, filter='data')
        for root, _, files in os.walk(tmp):
            for n in ('tailscale', 'tailscaled'):
                if n in files:
                    shutil.move(os.path.join(root, n), os.path.join(bin_dir(), n))
                    os.chmod(os.path.join(bin_dir(), n), 0o755)
    if not os.access(os.path.join(bin_dir(), 'tailscaled'), os.X_OK):
        sys.exit(f'{name} held no tailscaled: not installed.')


def cli(*args, check=False):
    return subprocess.run([os.path.join(bin_dir(), 'tailscale'), f'--socket={socket_path()}', *args], capture_output=True, text=True, check=check)


def running():
    with socket.socket(socket.AF_UNIX) as s:
        try:
            s.connect(socket_path())
            return True
        except OSError:
            return False


def start():
    if running():
        return
    # A bot's own Tailscale from before (#104, as box in its home) would hold the proxy's port: it ends.
    subprocess.run(['pkill', '-u', BOX, '-x', 'tailscaled'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    own_dir()
    os.makedirs(state_dir(), mode=0o700, exist_ok=True)
    log = open(os.path.join(DIR, 'tailscaled.log'), 'ab')
    subprocess.Popen([os.path.join(bin_dir(), 'tailscaled'), '--tun=userspace-networking', f'--statedir={state_dir()}',
                      f'--socket={socket_path()}', f'--socks5-server={PROXY}', f'--outbound-http-proxy-listen={PROXY}'],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        if running():
            return
        time.sleep(0.2)
    sys.exit(f'Tailscale did not start: see {os.path.join(DIR, "tailscaled.log")}')


def signed_in():
    """Whether tailscaled's state holds a login: its _profiles, base64 JSON, names one once the owner approved it."""
    try:
        with open(os.path.join(state_dir(), 'tailscaled.state')) as f:
            return bool(json.loads(base64.b64decode(json.load(f).get('_profiles', ''))))
    except (OSError, ValueError, AttributeError):
        return False


def resume():
    if signed_in() and installed():
        start()
        # A bot with sudo may have let connections in: each start puts the shields back up.
        cli('set', '--shields-up=true')


def status():
    return json.loads(cli('status', '--json').stdout or '{}')


def up(name=None):
    install()
    start()
    args = ['up', '--shields-up', '--timeout=20s']
    if name:
        args.append(f'--hostname={name}')
    cli(*args)
    s = status()
    if s.get('BackendState') == 'Running':
        ips = ', '.join(s.get('Self', {}).get('TailscaleIPs', []))
        print(f'The computer is on the tailnet as {s.get("Self", {}).get("DNSName", "").rstrip(".")} ({ips}), for every bot on it. '
              f'Programs reach it through ALL_PROXY=socks5h://{PROXY}.')
    elif s.get('AuthURL'):
        print(f'Ask the owner to open this link and approve this computer: {s["AuthURL"]}\n'
              'Then run botdot-tailscale up again.')
    else:
        sys.exit(f'Tailscale is {s.get("BackendState", "not answering")}: see {os.path.join(DIR, "tailscaled.log")}')


def as_root(argv):
    """A bot runs this as box: it starts itself again as root, through the sudo every bot has (ADR 035)."""
    if os.geteuid() == 0:
        return
    try:
        os.execv(SUDO, [SUDO, '-n', sys.executable, '-I', os.path.abspath(argv[0]), *argv[1:]])
    except OSError:
        pass
    sys.exit('botdot-tailscale needs sudo, and it could not be run.')


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd not in ('up', 'resume', 'status', 'down'):
        sys.exit(__doc__)
    as_root(argv)
    if cmd == 'up':
        up(argv[2] if len(argv) > 2 else None)
    elif cmd == 'resume':
        resume()
    elif cmd == 'status':
        if not running():
            sys.exit('Tailscale is not running here: botdot-tailscale up starts it.')
        print(cli('status').stdout, end='')
    elif cmd == 'down':
        if running():
            cli('down')
            subprocess.run(['pkill', '-u', '0', '-x', 'tailscaled'])
        print('Tailscale is stopped on this computer.')


if __name__ == '__main__':
    main(sys.argv)
