#!/bin/sh
# The screen kit on a bot's machine on boat.dev (#563, ADR 093): what the desktop image (deploy/desktop/Dockerfile)
# carries for a screen, put on the machine's own desktop (Xorg :0) the first time the bot uses a screen tool there.
# cua's computer-server and Camoufox, each in its own venv at the paths and versions the image has, botdot's bridge
# (camoufox-browser) and the browser user it runs as, with the bot's downloads in /home/user/Downloads.
#
# botdot (lib/boat.js) puts this file and camoufox-browser in a folder of /tmp through boat.dev's file API and runs
#   sudo sh botdot-boat-kit <version> <that folder>
# detached. It writes what it does to /opt/botdot/kit.log, and at its end <version> to /opt/botdot/kit-version, or
# the step that failed to /opt/botdot/kit-failed. It stays on the machine's disk: botdot runs it again only for a
# newer kit. Each step is safe to run again.
set -eu
VERSION="$1"
FROM="$2"
KIT=/opt/botdot
mkdir -p "$KIT"
rm -f "$KIT/kit-version" "$KIT/kit-failed"
exec >"$KIT/kit.log" 2>&1
step="start"
ended() {
  s=$?
  [ "$s" = 0 ] || printf '%s (exit %s)\n' "$step" "$s" > "$KIT/kit-failed"
  rm -rf "$FROM"
}
trap ended EXIT

step="the system's packages"
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
# python3-venv, -dev, -tk and gcc for the venvs and what pip builds there; x11-xserver-utils for xhost and xset;
# the libraries Firefox needs that a desktop with Chrome may lack.
apt-get install -y -q --no-install-recommends python3-venv python3-dev python3-tk gcc x11-xserver-utils \
  libgtk-3-0t64 libdbus-glib-1-2 libasound2t64 libx11-xcb1 libxtst6 fonts-liberation

step="the browser user"
# Camoufox and its bridge run as browser, in the group of the machine's user so it can save into its Downloads.
id browser >/dev/null 2>&1 || useradd --create-home --shell /usr/sbin/nologin --groups user browser
chmod 0700 /home/browser
install -d -o browser -g browser -m 0700 /home/browser/profiles
chmod g+x /home/user
install -d -o user -g user -m 2775 /home/user/Downloads

step="computer-server"
# As the image's Dockerfile: cua-computer-server and the fixes pinned beside it.
[ -x /opt/computer-server/venv/bin/python ] || python3 -m venv /opt/computer-server/venv
/opt/computer-server/venv/bin/pip install --no-cache-dir 'pip==26.2.2'
/opt/computer-server/venv/bin/pip install --no-cache-dir \
  'cua-computer-server==0.3.46' 'fastmcp==3.2.4' 'PyJWT==2.14.0' 'pillow==13.0.0' 'certifi==2026.10.19'
/opt/computer-server/venv/bin/pip check

step="Camoufox"
[ -x /opt/camoufox/bin/python ] || python3 -m venv /opt/camoufox
/opt/camoufox/bin/pip install --no-cache-dir 'camoufox[geoip]==0.5.6' 'certifi==2026.10.19'
XDG_CACHE_HOME=/opt/camoufox-cache /opt/camoufox/bin/python -m camoufox fetch official/152.0.4-beta.31
XDG_CACHE_HOME=/opt/camoufox-cache /opt/camoufox/bin/python -m camoufox set official/stable/152.0.4-beta.31
XDG_CACHE_HOME=/opt/camoufox-cache /opt/camoufox/bin/python -c "from camoufox.multiversion import get_active_path; import sys; sys.exit(0 if get_active_path() else \"Camoufox was not installed\")"
chmod -R a+rX,go-w /opt/camoufox-cache
install -d -o browser -g browser -m 0700 /opt/camoufox-cache/camoufox/fontconfig

step="the bridge"
install -m 0755 "$FROM/camoufox-browser" /usr/local/bin/camoufox-browser

step="done"
printf '%s\n' "$VERSION" > "$KIT/kit-version"
