#!/usr/bin/python3 -I
"""botdot's root helper for the account's computer: what `sudo` talks to (ADR 260).

Every bot works on the computer as `box`, with root through sudo (ADR 035). Under gVisor the setuid bit of /usr/bin/sudo
is ignored on the container's root mount ("effective uid is not 0 ... nosuid", #1562), so sudo cannot be the way to
root there. This file is: one root process of the computer, started by botdot with `docker exec -u root`, on a Unix
socket that only `box` (and root) may use. /usr/local/bin/sudo (deploy/desktop/botdot-sudo) is its client: it sends the
command, its environment and its own stdin, stdout and stderr (SCM_RIGHTS), the helper runs the command as the target
user with those, passes on the signals the client got, and answers with the exit code. Nothing in it relies on setuid
or on a file mode; the one check is the user id of the process on the other end of the socket (SO_PEERCRED).

  botdot-sudod --ensure     make sure a helper of this very file is running (starts it, or replaces an older one after
                            its commands end); what botdot runs at each start of the computer
  botdot-sudod --serve      the helper itself, in the foreground

The socket is /run/botdot-sudo/sudo.sock. BOTDOT_SUDO_SOCKET and BOTDOT_SUDO_ALLOW (user ids) are for the tests.
botdot sends its own copy with each start (lib/computers.js syncScripts), so a computer made before this has it too."""
import hashlib
import json
import os
import pwd
import grp
import shlex
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

SOCKET = os.environ.get("BOTDOT_SUDO_SOCKET") or "/run/botdot-sudo/sudo.sock"
USER = "box"
MAX_REQUEST = 1024 * 1024
# What sudo keeps of the caller's environment (env_reset), and the PATH it gives the command (secure_path).
KEEP = {"TERM", "COLORS", "DISPLAY", "HOSTNAME", "KRB5CCNAME", "LS_COLORS", "PS1", "PS2", "XAUTHORITY", "XAUTHORIZATION",
        "XDG_CURRENT_DESKTOP", "LANG", "LANGUAGE", "TZ"}
SECURE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# The signals a client passes on to the command it started.
SIGNALS = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGUSR1, signal.SIGUSR2, signal.SIGCONT,
           signal.SIGTSTP, signal.SIGWINCH}
GRACE = 5.0  # how long a command has to end after its client went away, before SIGKILL


def build():
    """What identifies this file: a running helper of another build is replaced."""
    with open(os.path.abspath(__file__), "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()[:16]


BUILD = build()  # read once: a helper keeps answering as the build it started as, when its file is replaced under it


def allowed():
    if os.environ.get("BOTDOT_SUDO_ALLOW"):
        return {int(u) for u in os.environ["BOTDOT_SUDO_ALLOW"].split(",") if u.strip()}
    try:
        return {0, pwd.getpwnam(USER).pw_uid}
    except KeyError:
        return {0}


class Drain(Exception):
    """SIGUSR1: stop taking commands, and end when those running have."""


def recv_exact(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise EOFError
        data += chunk
    return data


def reply(conn, text):
    try:
        conn.sendall(text.encode() + b"\n")
    except OSError:
        pass


def user_of(name):
    try:
        return pwd.getpwuid(int(name[1:])) if name.startswith("#") else pwd.getpwnam(name)
    except (KeyError, ValueError):
        return None


def group_of(name):
    try:
        return grp.getgrgid(int(name[1:])) if name.startswith("#") else grp.getgrnam(name)
    except (KeyError, ValueError):
        return None


def plan(req, target, peer_uid, peer_gid):
    """The command's argv, environment and working folder, as sudo makes them from the request."""
    words = req["argv"]
    mode = req.get("mode", "command")
    environ = req.get("environ", {})
    if mode == "command":
        argv = list(words)
    else:
        shell = (environ.get("SHELL") if mode == "shell" and environ.get("SHELL") else None) or target.pw_shell or "/bin/sh"
        argv = [shell, *(["-l"] if mode == "login" and not words else []), *(["-c", " ".join(shlex.quote(w) for w in words)] if words else [])]
    if req.get("preserve_env") and mode != "login":
        env = dict(environ)
    else:
        env = {k: v for k, v in environ.items() if k in KEEP or k.startswith("LC_")}
    env.update(PATH=SECURE_PATH, HOME=target.pw_dir, USER=target.pw_name, LOGNAME=target.pw_name, SHELL=target.pw_shell or "/bin/sh",
               SUDO_COMMAND=" ".join(argv), SUDO_UID=str(peer_uid), SUDO_GID=str(peer_gid))
    try:
        env["SUDO_USER"] = pwd.getpwuid(peer_uid).pw_name
    except KeyError:
        env["SUDO_USER"] = str(peer_uid)
    env.update({str(k): str(v) for k, v in req.get("set", {}).items()})
    cwd = req.get("chdir") or (target.pw_dir if mode == "login" else req.get("cwd")) or "/"
    return argv, env, cwd


def serve_one(conn, allow):
    fds = []
    try:
        pid, uid, gid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        head, fds, _, _ = socket.recv_fds(conn, 4, 3)
        if len(head) < 4:
            head += recv_exact(conn, 4 - len(head))
        size = struct.unpack(">I", head)[0]
        if size == 0:  # a ping: whose build answers, and its pid
            return reply(conn, f"P {BUILD} {os.getpid()}")
        if uid not in allow:
            return reply(conn, "E sudo: you are not allowed to use sudo on this computer")
        if size > MAX_REQUEST or len(fds) != 3:
            return reply(conn, "E sudo: bad request")
        req = json.loads(recv_exact(conn, size))
        if not isinstance(req.get("argv"), list) or not all(isinstance(w, str) for w in req["argv"]) or (not req["argv"] and req.get("mode", "command") == "command"):
            return reply(conn, "E sudo: bad request")
        target = user_of(req.get("user") or "root")
        if not target:
            return reply(conn, f"E sudo: unknown user {req.get('user')}")
        argv, env, cwd = plan(req, target, uid, gid)
        extra = {}
        if target.pw_uid != 0:
            group = group_of(req["group"]) if req.get("group") else None
            if req.get("group") and not group:
                return reply(conn, f"E sudo: unknown group {req['group']}")
            extra = {"user": target.pw_uid, "group": group.gr_gid if group else target.pw_gid, "extra_groups": os.getgrouplist(target.pw_name, target.pw_gid)}
        elif req.get("group"):
            group = group_of(req["group"])
            if not group:
                return reply(conn, f"E sudo: unknown group {req['group']}")
            extra = {"group": group.gr_gid}
        try:
            proc = subprocess.Popen(argv, stdin=fds[0], stdout=fds[1], stderr=fds[2], cwd=cwd, env=env, start_new_session=True, **extra)
        except FileNotFoundError as e:
            return reply(conn, f"E sudo: {e.filename or argv[0]}: " + ("command not found" if e.filename == argv[0] else "no such file or directory"))
        except OSError as e:
            return reply(conn, f"E sudo: {argv[0]}: {e.strerror or e}")
        for fd in fds:
            os.close(fd)
        fds = []
        finish(conn, proc)
    except (EOFError, OSError, ValueError, KeyError):
        pass
    finally:
        for fd in fds:
            os.close(fd)
        try:
            conn.shutdown(socket.SHUT_RDWR)  # wakes the thread that listens for the client's signals
        except OSError:
            pass
        conn.close()


def finish(conn, proc):
    """The command runs: the client's signals go to it, and it is ended if the client goes away. Its exit code is the answer."""
    done = threading.Event()

    def stop():
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except OSError:
                return
            for _ in range(int(GRACE * 10)):
                if done.wait(0.1):
                    return
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass

    def listen():
        buffer = b""
        while True:
            try:
                chunk = conn.recv(64)
            except OSError:
                chunk = b""
            if not chunk or done.is_set():
                break
            buffer += chunk
            while len(buffer) >= 2:
                kind, number, buffer = buffer[:1], buffer[1], buffer[2:]
                if kind == b"S" and number in SIGNALS and proc.poll() is None:
                    try:
                        os.killpg(proc.pid, number)
                    except OSError:
                        pass
        if not done.is_set():
            stop()

    threading.Thread(target=listen, daemon=True).start()
    code = proc.wait()
    done.set()
    reply(conn, f"X {code if code >= 0 else 128 - code}")


class Running:
    """How many commands are running: a draining helper ends when none is."""
    def __init__(self):
        self.n = 0
        self.lock = threading.Lock()

    def __enter__(self):
        with self.lock:
            self.n += 1

    def __exit__(self, *_):
        with self.lock:
            self.n -= 1


def serve():
    allow = allowed()
    os.makedirs(os.path.dirname(SOCKET), mode=0o755, exist_ok=True)
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCKET)
    os.chmod(SOCKET, 0o666)  # whoever may connect, the user id of the one who did decides (serve_one)
    srv.listen(64)
    running = Running()

    def drain(*_):
        raise Drain

    signal.signal(signal.SIGUSR1, drain)

    def handle(conn):
        with running:
            serve_one(conn, allow)

    try:
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except Drain:
        srv.close()
        while running.n:
            time.sleep(0.5)


def ask():
    """The helper that answers on the socket: (build, pid), or None."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(3)
    try:
        s.connect(SOCKET)
        s.sendall(struct.pack(">I", 0))
        line = b""
        while not line.endswith(b"\n"):
            chunk = s.recv(256)
            if not chunk:
                return None
            line += chunk
        said = line.decode().split()
        return (said[1], int(said[2])) if said[0] == "P" else None
    except (OSError, ValueError, IndexError):
        return None
    finally:
        s.close()


def ensure():
    mine = build()
    there = ask()
    if there and there[0] == mine:
        return
    if there:  # an older build: it takes no more commands and ends when its own have
        try:
            os.kill(there[1], signal.SIGUSR1)
        except OSError:
            pass
        time.sleep(0.3)
    subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "--serve"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    for _ in range(100):
        there = ask()
        if there and there[0] == mine:
            return
        time.sleep(0.1)
    sys.exit("botdot-sudod did not start")


if __name__ == "__main__":
    if sys.argv[1:] == ["--serve"]:
        serve()
    elif sys.argv[1:] == ["--ensure"]:
        ensure()
    else:
        sys.exit(__doc__)
