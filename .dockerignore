# Only what botdot needs to run goes into the image (an allowlist): never your data, local settings,
# a .env with tokens, or anything else that happens to be in this folder.
*
!server.js
!front-door.js
!package.json
!lib/
!install.sh
!public/
!chief-skills/
# The skills every bot and the Chief get (#398).
!bot-skills/
!vendor/
!deploy/desktop/
# Read back out of the image by install.sh: the background computer download and a demo's fictional data.
!deploy/prepare-computers.sh
!deploy/seed-demo.js
# The What's new notes the server shows after an update (#219).
!whats-new/
# Read back out of the image by install.sh and the updater in Settings.
!compose.yaml
!compose.front-door.yaml
# The Android app CI puts here for botdot to hand out (images.yml).
!android-app/

# …and never secrets or clutter, even inside those.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/.DS_Store
**/*.log
