      "runs": [{ "id": "r1", "status": "success", "startedAt": "2026-10-23T11:39:00.000Z", "endedAt": "2026-10-23T11:45:00.000Z" }],
      "pieces": ["a:r1", "r:r1"],
      "last": "r1"
    },
    {
      "name": "runs one after another keep their exchanges",
