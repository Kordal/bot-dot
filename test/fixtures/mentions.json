{
  "about": [
    "The Mention rules (CONTEXT.md, issue #83), as cases every app's matcher must pass: lib/mentions.js, web, Android, Mac.",
    "maxRows: the most suggestion rows shown at once.",
    "shortNames: [name, short name] pairs. Words are joined, each capitalised; only letters, digits, '_' and '-' are kept.",
    "worlds: the bots (the Chief included, as id 'chief'), their jobs and picked skills, and the skill library. A bot with useSkills false has no skills.",
    "cases: { name, world, chat, text?, matches?, typed?, suggestions? }. chat is 'chief' or a bot id: skills in scope are the whole library in the Chief chat, the bot's picked skills in its own chat.",
    "matches: the mentions found in text, in order, as { kind: bot|job|skill, text, bot?, job?, skill? } (bot and job are ids, skill a name; text is the part of the message that is the mention).",
    "suggestions: the rows offered while the text before the cursor is typed, in order, as the text a pick inserts (followed by a space). [] means no list. Rows: bots, then jobs, then skills; a skill named like a bot is left out; after '@Bot/' only that bot's jobs; matching is a case-insensitive 'contains' on the short name.",
    "picks: { name, world, chat, before, pick, after, jobsNext }. before and after are the whole message with '|' where the cursor is. pick is the text of the suggested row (for the text before the cursor) that is picked. Picking puts the row's text in place of the '@…' before the cursor and the rest of that word, then a space unless a space (not a line break) follows already; the cursor goes after the space. jobsNext: a bot was picked and the space is new, so a '/' typed next replaces the space and lists the bot's jobs."
  ],
  "maxRows": 6,
  "shortNames": [
    ["Fleet Doctor", "FleetDoctor"],
    ["Chief of Staff", "ChiefOfStaff"],
    ["Morning check", "MorningCheck"],
    ["  todo   keeper ", "TodoKeeper"],
    ["Bot's helper", "BotsHelper"],
    ["X-Ray 2", "X-Ray2"],
    ["🧪 Lab", "Lab"],
    ["Café crème", "CaféCrème"]
  ],
  "worlds": {
    "team": {
      "bots": [
        { "id": "chief", "name": "Chief of Staff", "jobs": [] },
        { "id": "fleet", "name": "Fleet Doctor", "skills": ["weekly-report", "digest"], "jobs": [
          { "id": "j1", "name": "Morning check" },
          { "id": "j2", "name": "Disk sweep" }
        ] },
        { "id": "todo", "name": "Todo Keeper", "skills": [], "jobs": [{ "id": "j3", "name": "Weekly review" }] },
        { "id": "social", "name": "Social Watch", "useSkills": false, "skills": ["tone"], "jobs": [] },
        { "id": "digest", "name": "Digest", "jobs": [] },
        { "id": "mail", "name": "Mail Bot", "jobs": [{ "id": "j4", "name": "Morning digest" }] },
        { "id": "dock", "name": "Dock Watcher", "jobs": [] }
      ],
      "library": [
        { "name": "digest", "description": "Write a short digest." },
        { "name": "report-pdf", "description": "Turn a report into a PDF." },
        { "name": "tone", "description": "The owner's writing tone." },
        { "name": "weekly-report", "description": "How the weekly report is laid out." }
      ]
    }
  },
  "cases": [
    { "name": "a bot, its name squashed", "world": "team", "chat": "chief", "text": "Ask @FleetDoctor about the disks",
      "matches": [{ "kind": "bot", "text": "@FleetDoctor", "bot": "fleet" }] },
    { "name": "the Chief is a bot too", "world": "team", "chat": "fleet", "text": "Tell @ChiefOfStaff when it's done",
      "matches": [{ "kind": "bot", "text": "@ChiefOfStaff", "bot": "chief" }] },
    { "name": "at the very start", "world": "team", "chat": "chief", "text": "@TodoKeeper",
      "matches": [{ "kind": "bot", "text": "@TodoKeeper", "bot": "todo" }] },
    { "name": "a job: bot/job", "world": "team", "chat": "chief", "text": "Did @FleetDoctor/MorningCheck run?",
      "matches": [{ "kind": "job", "text": "@FleetDoctor/MorningCheck", "bot": "fleet", "job": "j1" }] },
    { "name": "matching ignores case", "world": "team", "chat": "chief", "text": "@fleetdoctor/morningcheck and @TODOKEEPER",
      "matches": [{ "kind": "job", "text": "@fleetdoctor/morningcheck", "bot": "fleet", "job": "j1" }, { "kind": "bot", "text": "@TODOKEEPER", "bot": "todo" }] },
    { "name": "a job that doesn't exist leaves just the bot", "world": "team", "chat": "chief", "text": "@FleetDoctor/Nope",
      "matches": [{ "kind": "bot", "text": "@FleetDoctor", "bot": "fleet" }] },
    { "name": "a skill, its name as is", "world": "team", "chat": "chief", "text": "Use @weekly-report for it",
      "matches": [{ "kind": "skill", "text": "@weekly-report", "skill": "weekly-report" }] },
    { "name": "a skill, ignoring case", "world": "team", "chat": "chief", "text": "@Weekly-Report",
      "matches": [{ "kind": "skill", "text": "@Weekly-Report", "skill": "weekly-report" }] },
    { "name": "a bot wins over a skill of the same name", "world": "team", "chat": "chief", "text": "@digest please",
      "matches": [{ "kind": "bot", "text": "@digest", "bot": "digest" }] },
    { "name": "a bot's own chat: its picked skills", "world": "team", "chat": "fleet", "text": "@weekly-report, not @report-pdf",
      "matches": [{ "kind": "skill", "text": "@weekly-report", "skill": "weekly-report" }] },
    { "name": "a bot without picked skills", "world": "team", "chat": "todo", "text": "@weekly-report",
      "matches": [] },
    { "name": "a bot with skills switched off", "world": "team", "chat": "social", "text": "@tone",
      "matches": [] },
    { "name": "no match inside a word", "world": "team", "chat": "chief", "text": "mail me@FleetDoctor.com or x@tone",
      "matches": [] },
    { "name": "text that matches nothing stays plain", "world": "team", "chat": "chief", "text": "@Nobody and @ghost-skill and @ alone",
      "matches": [] },
    { "name": "punctuation around mentions", "world": "team", "chat": "chief", "text": "Thanks, @FleetDoctor! And (@TodoKeeper).",
      "matches": [{ "kind": "bot", "text": "@FleetDoctor", "bot": "fleet" }, { "kind": "bot", "text": "@TodoKeeper", "bot": "todo" }] },
    { "name": "several kinds in one message", "world": "team", "chat": "chief", "text": "@MailBot: move @MailBot/MorningDigest and use @tone",
      "matches": [{ "kind": "bot", "text": "@MailBot", "bot": "mail" }, { "kind": "job", "text": "@MailBot/MorningDigest", "bot": "mail", "job": "j4" }, { "kind": "skill", "text": "@tone", "skill": "tone" }] },

    { "name": "a bare @ lists bots first, at most maxRows", "world": "team", "chat": "chief", "typed": "@",
      "suggestions": ["@ChiefOfStaff", "@FleetDoctor", "@TodoKeeper", "@SocialWatch", "@Digest", "@MailBot"] },
    { "name": "filtered as you type", "world": "team", "chat": "chief", "typed": "Ask @fle",
      "suggestions": ["@FleetDoctor"] },
    { "name": "the Chief is offered", "world": "team", "chat": "fleet", "typed": "@chief",
      "suggestions": ["@ChiefOfStaff"] },
    { "name": "bots, then jobs, then skills", "world": "team", "chat": "chief", "typed": "@ee",
      "suggestions": ["@FleetDoctor", "@TodoKeeper", "@FleetDoctor/DiskSweep", "@TodoKeeper/WeeklyReview", "@weekly-report"] },
    { "name": "jobs, then skills", "world": "team", "chat": "chief", "typed": "@re",
      "suggestions": ["@TodoKeeper/WeeklyReview", "@report-pdf", "@weekly-report"] },
    { "name": "a bot's chat offers only its picked skills", "world": "team", "chat": "fleet", "typed": "@re",
      "suggestions": ["@TodoKeeper/WeeklyReview", "@weekly-report"] },
    { "name": "a bot without skills offers none", "world": "team", "chat": "todo", "typed": "@re",
      "suggestions": ["@TodoKeeper/WeeklyReview"] },
    { "name": "a skill named like a bot is left out", "world": "team", "chat": "chief", "typed": "@dig",
      "suggestions": ["@Digest", "@MailBot/MorningDigest"] },
    { "name": "a / after a bot lists its jobs", "world": "team", "chat": "chief", "typed": "@FleetDoctor/",
      "suggestions": ["@FleetDoctor/MorningCheck", "@FleetDoctor/DiskSweep"] },
    { "name": "its jobs, filtered, ignoring case", "world": "team", "chat": "chief", "typed": "Did @fleetdoctor/d",
      "suggestions": ["@FleetDoctor/DiskSweep"] },
    { "name": "a / after something that isn't a bot", "world": "team", "chat": "chief", "typed": "@Nobody/",
      "suggestions": [] },
    { "name": "nothing matches", "world": "team", "chat": "chief", "typed": "@zzz",
      "suggestions": [] },
    { "name": "no list inside a word", "world": "team", "chat": "chief", "typed": "me@fle",
      "suggestions": [] },
    { "name": "no list once the word has ended", "world": "team", "chat": "chief", "typed": "@FleetDoctor ",
      "suggestions": [] }
  ],
  "picks": [
    { "name": "a bot at the end", "world": "team", "chat": "chief", "before": "Ask @fle|", "pick": "@FleetDoctor",
      "after": "Ask @FleetDoctor |", "jobsNext": true },
    { "name": "a bot mid-word takes the rest of the word", "world": "team", "chat": "chief", "before": "Ask @fle|et now", "pick": "@FleetDoctor",
      "after": "Ask @FleetDoctor |now", "jobsNext": false },
    { "name": "a bot before other text gets a space", "world": "team", "chat": "chief", "before": "@to|, then", "pick": "@TodoKeeper",
      "after": "@TodoKeeper |, then", "jobsNext": true },
    { "name": "a job after a /", "world": "team", "chat": "chief", "before": "Did @FleetDoctor/d| run?", "pick": "@FleetDoctor/DiskSweep",
      "after": "Did @FleetDoctor/DiskSweep |run?", "jobsNext": false },
    { "name": "a job typed by its name", "world": "team", "chat": "chief", "before": "@sweep|", "pick": "@FleetDoctor/DiskSweep",
      "after": "@FleetDoctor/DiskSweep |", "jobsNext": false },
    { "name": "a skill", "world": "team", "chat": "fleet", "before": "Use @week|", "pick": "@weekly-report",
      "after": "Use @weekly-report |", "jobsNext": false },
    { "name": "on a later line, text after it kept", "world": "team", "chat": "chief", "before": "Hi\n@mail|\nthanks", "pick": "@MailBot",
      "after": "Hi\n@MailBot |\nthanks", "jobsNext": true }
  ]
}
